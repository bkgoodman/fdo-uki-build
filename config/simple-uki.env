# Simple UKI build configuration
# Override these variables or set them in your environment

# Ubuntu mini-ISO (snapshot build — no stable public URL)
# Place the ISO in assets/ manually, or set MINI_ISO_URL to download.
MINI_ISO_NAME=ubuntu-mini-iso-26.10-snapshot1-mini-iso-amd64.iso
MINI_ISO_URL=
MINI_ISO_SHA256=

# Deployment target (optional — only used by deploy step)
DEPLOY_HOST=
DEPLOY_FIRMWARE_DIR=/tmp/fdo-firmware-server
