# ROS 2 installer = Ubuntu 26.04.1 live-server ISO (pins come from
# config/ubuntu-installer.env, sourced first by the builder) + an offline,
# pinned ROS 2 apt bundle delivered as an extra FDO payload.

# ROS 2 Lyrical Luth (May 2026 LTS); Tier 1 platform: Ubuntu 26.04 "resolute" amd64
ROS_DISTRO=lyrical
UBUNTU_SUITE=resolute
ROS2_PACKAGES="ros-lyrical-ros-base ros-lyrical-demo-nodes-cpp ros-lyrical-demo-nodes-py"

# Immutable package sources: a ROS snapshot (snapshots.ros.org) and the matching
# Ubuntu archive snapshot (snapshot.ubuntu.com), so the bundle is reproducible.
ROS_SNAPSHOT=2026-09-18
ROS_SNAPSHOT_URL=http://snapshots.ros.org/lyrical/2026-09-18/ubuntu
# ROS snapshot signing key (docs.ros.org "Installing from the snapshot repository")
ROS_SNAPSHOT_KEY_FPR=4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA
ROS_SNAPSHOT_KEY_URL="https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA"
UBUNTU_SNAPSHOT=20261002T040000Z
UBUNTU_SNAPSHOT_URL=http://snapshot.ubuntu.com/ubuntu/20261002T040000Z
UBUNTU_ARCHIVE_KEYRING=/usr/share/keyrings/ubuntu-archive-keyring.gpg

# ros2-apt-source: installs the official ROS apt source + key on the device for later updates
ROS_APT_SOURCE_VERSION=1.3.0
ROS_APT_SOURCE_URL=https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.3.0/ros2-apt-source_1.3.0.resolute_all.deb
ROS_APT_SOURCE_SHA256=e70bc980395f4a3b366b9c5e7f8f9b4d63a4064fb115f6ff3bc52f7faa02ef69

ROS2_BUNDLE_NAME=ros2-lyrical-2026-09-18-bundle.tar
ROS2_BUNDLE_MIME=application/vnd.ros2.apt-bundle+tar
ROS2_AUTOINSTALL=config/autoinstall-ros2.yaml
INSTALLER_UKI_NAME=ubuntu-26.04.1-ros2-lyrical-fdo.efi
# Deployment target (set in your environment or override here)
DEPLOY_HOST=${DEPLOY_HOST:-}
DEPLOY_FIRMWARE_DIR=${DEPLOY_FIRMWARE_DIR:-/tmp/fdo-firmware-server}
