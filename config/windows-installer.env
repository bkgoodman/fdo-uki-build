WINDOWS_ISO_NAME=26100.1742.240906-0331.ge_release_svc_refresh_SERVER_EVAL_x64FRE_en-us.iso
# Official Evaluation Center fwlink (linkid=2293312) redirects here.
WINDOWS_ISO_URL=https://software-static.download.prss.microsoft.com/dbazure/888969d5-f34g-4e03-ac9d-1f9786c66749/26100.1742.240906-0331.ge_release_svc_refresh_SERVER_EVAL_x64FRE_en-us.iso
# Microsoft does not publish this hash on the Evaluation Center; it matches
# independent records (files.rg-adguard.net, public packer configs).
WINDOWS_ISO_SHA256=d0ef4502e350e3c6c53c15b1b3020d38a5ded011bf04998e950720ac8579b23d
WINDOWS_ISO_SIZE=6014152704
# UDF volume label; the ISO9660 side holds only README.TXT (needs a UDF mount)
WINDOWS_ISO_LABEL=SSS_X64FREE_EN-US_DV9
# sources/boot.wim: index 1 = WinPE, index 2 = Windows Setup (boot index)
WINDOWS_BOOT_WIM_SHA256=d048a5853ef0a6122d30c96f1be64be565ec959270751167ca34d60aa89a9fe4
WIMBOOT_VERSION=v2.9.0
WIMBOOT_URL=https://github.com/ipxe/wimboot/releases/download/v2.9.0/wimboot
WIMBOOT_SHA256=5f067ccdc4d084d5bf77b6c853bd0f8402dfc2b4cd1b103d358993ae97fae8e3

# Which images to export (wimlib-imagex export, no recompression).
# boot.wim index 1 = plain WinPE (index 2 = Setup would start setup.exe).
WINPE_INDEX=1
# install.wim: 1 SERVERSTANDARDCORE, 2 SERVERSTANDARD (Desktop Experience),
# 3 SERVERDATACENTERCORE, 4 SERVERDATACENTER. The build checks the name.
INSTALL_INDEX=1
INSTALL_IMAGE_NAME="Windows Server 2025 SERVERSTANDARDCORE"

# Outputs (firmware/, like the Linux targets)
INSTALLER_UKI_NAME=windows-server-2025-fdo.efi
INSTALL_WIM_NAME=windows-server-2025-standard-core.wim
# Per-device answer file for the test (Payload application/vnd.microsoft.unattend+xml)
WINDOWS_UNATTEND=config/unattend-test.xml
WINDOWS_UNATTEND_MIME=application/vnd.microsoft.unattend+xml
WINDOWS_WIM_MIME=application/vnd.microsoft.wim

# fdo-uefi-rs aborts URL / meta-URL (HTTP) downloads above this
# (tcp4_http.rs MAX_RESPONSE_BYTES); inline BMO has no cap.
FDO_UEFI_URL_CAP=536870912

# Deployment target (set in your environment or override here)
DEPLOY_HOST=${DEPLOY_HOST:-}
DEPLOY_FIRMWARE_DIR=${DEPLOY_FIRMWARE_DIR:-/tmp/fdo-firmware-server}
# Where build-windows-installer.sh DEPLOY=1 puts the test scripts on the host
DEPLOY_SCRIPT_DIR=${DEPLOY_SCRIPT_DIR:-fdo-windows}
