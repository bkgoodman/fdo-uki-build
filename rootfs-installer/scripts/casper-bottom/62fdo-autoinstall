#!/bin/sh

PREREQ=""
DESCRIPTION="Installing FDO-delivered NoCloud seed..."

prereqs()
{
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /scripts/casper-functions

log_begin_msg "$DESCRIPTION"

if [ ! -s /run/fdo/autoinstall/user-data ] || [ ! -e /run/fdo/autoinstall/meta-data ]; then
    echo "FDO installer error: NoCloud seed is incomplete" >&2
    exit 1
fi

echo "FDO: Copying autoinstall files..."
echo "FDO: user-data size: $(wc -c < /run/fdo/autoinstall/user-data)"
echo "FDO: meta-data exists: $([ -e /run/fdo/autoinstall/meta-data ] && echo yes || echo no)"

seed_dir=/root/var/lib/cloud/seed/nocloud
mkdir -p "$seed_dir"
cp /run/fdo/autoinstall/user-data "$seed_dir/user-data"
cp /run/fdo/autoinstall/meta-data "$seed_dir/meta-data"
cp /run/fdo/autoinstall/user-data /autoinstall.yaml
chmod 0600 "$seed_dir/user-data" /autoinstall.yaml
chmod 0644 "$seed_dir/meta-data"

echo "FDO: Files copied to $seed_dir and /autoinstall.yaml"
echo "FDO: /autoinstall.yaml exists: $([ -e /autoinstall.yaml ] && echo yes || echo no)"
echo "FDO: /autoinstall.yaml size: $(wc -c < /autoinstall.yaml)"

log_end_msg
