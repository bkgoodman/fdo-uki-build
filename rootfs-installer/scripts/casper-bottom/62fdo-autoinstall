#!/bin/sh

PREREQ=""
DESCRIPTION="Installing FDO-delivered autoinstall config..."

prereqs()
{
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /scripts/casper-functions

log_begin_msg "$DESCRIPTION"

if [ ! -s /run/fdo/autoinstall/user-data ]; then
    echo "FDO: No autoinstall user-data found, skipping" >&2
    log_end_msg
    exit 0
fi

# Copy the autoinstall config to /root/autoinstall.yaml.
# After casper root-switch, /root/ becomes /, so this file ends up at
# /autoinstall.yaml — matching the kernel cmdline parameter:
#   subiquity.autoinstallpath=/autoinstall.yaml
cp /run/fdo/autoinstall/user-data /root/autoinstall.yaml
chmod 0600 /root/autoinstall.yaml

echo "FDO: autoinstall.yaml installed ($(wc -c < /root/autoinstall.yaml) bytes)"
echo "FDO: first line: $(head -1 /root/autoinstall.yaml)"

log_end_msg
